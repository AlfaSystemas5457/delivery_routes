<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_config_list"
        model="ir.ui.view">
        <field name="name">delivery.config.list</field>
        <field name="model">delivery.config</field>
        <field name="arch"
            type="xml">
            <list string="Terminales">
                <field name="name"/>
                <field name="driver_id"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_config_kanban"
        model="ir.ui.view">
        <field name="name">delivery.config.kanban</field>
        <field name="model">delivery.config</field>
        <field name="arch"
            type="xml">
            <kanban class="o_kanban_small_column">
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_body d-flex flex-row justify-content-between align-items-center w-100">
                            <div class="d-flex flex-column">
                                <div class="o_kanban_primary">
                                    <field name="name"/>
                                </div>
                                <div class="o_kanban_secondary">
                                    <field name="driver_id"/>
                                </div>
                            </div>
                            <div class="m-0">
                                <button name="%(delivery_routes.action_delivery_pos_gui)d"
                                    type="action"
                                    class="btn btn-primary w-100">
                                    Entrar a Terminal
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_delivery_config_form"
        model="ir.ui.view">
        <field name="name">delivery.config.form</field>
        <field name="model">delivery.config</field>
        <field name="arch"
            type="xml">
            <form string="Terminal">
                <header>
                    <button name="%(delivery_routes.action_delivery_pos_gui)d"
                        string="Entrar a Terminal"
                        type="action"
                        class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                placeholder="Nombre del Terminal"/>
                        </h1>
                    </div>
                    <group>
                        <field name="driver_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_delivery_config"
        model="ir.actions.act_window">
        <field name="name">Terminales</field>
        <field name="path">terminal</field>
        <field name="res_model">delivery.config</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help"
            type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea terminales de reparto y asígnales un repartidor.
            </p>
        </field>
    </record>

    <menuitem id="menu_delivery_config"
        parent="delivery_routes.main_menu"
        name="Terminales"
        action="action_delivery_config"
        sequence="1"/>

</odoo>