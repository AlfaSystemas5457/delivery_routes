<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_account"
        model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id"
            ref="account.view_move_form"/>
        <field name="arch"
            type="xml">
            <xpath expr="//header/button[@name='action_post']"
                position="before">
                <button name="do_print_ticket"
                    string="Imprimir Ticket"
                    type="object"
                    class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>
