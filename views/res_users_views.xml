<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_users_form_inherit_access_scope" model="ir.ui.view">
        <field name="name">res.users.form.inherit.access.scope</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group[1]" position="after">
                <group string="Accesos a la gestión de rutas">
                    <field name="access_scope" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>