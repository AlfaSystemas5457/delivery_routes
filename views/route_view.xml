<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="route_sale_sequence"
        model="ir.sequence">
        <field name="name">Route Sale</field>
        <field name="code">route.route.sequence</field>
        <field name="prefix">RS-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
    </record>

    <record id="view_route_form"
        model="ir.ui.view">
        <field name="name">route.route.form</field>
        <field name="model">route.route</field>
        <field name="priority"
            eval="99" />
        <field name="arch"
            type="xml">
            <form string="Ruta de Venta">
                <header>
                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="start,process,end" />
                    <button name="action_process"
                        string="Iniciar"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'start'" />
                    <button name="action_end"
                        string="Finalizar"
                        type="object"
                        class="btn-success"
                        invisible="state != 'process'" />
                    <button name="action_start"
                        string="Regresar a inicio"
                        type="object"
                        class="btn-secondary"
                        groups="delivery_routes.group_route_access_all" />
                </header>
                <sheet>
                    <group>
                        <h1>
                            <field name="name"
                                placeholder="Nombre de la ruta"
                                colspan="4"
                                readonly="1" />
                        </h1>
                    </group>
                    <group>
                        <group>
                            <field name="description"
                                placeholder="Descripción de la ruta"
                                readonly="1" />
                            <field name="product"
                                placeholder="Seleccione el producto"
                                widget="many2many_tags"
                                readonly="1" />
                        </group>
                        <group>
                            <field name="salesperson_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                readonly="1"
                                placeholder="Selecciona los repartidores"/>
                            <field name="warehouse_id"
                                readonly="1"/>
                            <field name="currency_id"
                                invisible="1"/>
                            <field name="amount_total"
                                readonly="1"/>
                        </group>
                        <group>
                            <button string="Recargar direcciones"
                                name="action_reload_route_address_ids"
                                type="object"
                                readonly="state != 'start'"
                                invisible="state != 'start'"
                                class="oe_highlight"
                                colspan="4"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Direcciones">
                            <field name="route_address_ids"
                                readonly="state == 'end'">
                                <list create="false">
                                    <control>
                                        <delete invisible="parent.state != 'start'"/>
                                    </control>
                                    <field name="contact" />
                                    <field name="address"
                                        readonly="1" />
                                    <field name="status"
                                        widget="badge"
                                        decoration-danger="status == 'skipped'"
                                        decoration-success="status == 'visited'"
                                        decoration-warning="status == 'pending'" />
                                    <field name="sale_order_id"
                                        widget="many2one" />
                                    <button name="open_map"
                                        type="object"
                                        class="oe_stat_button"
                                        string="Ver en el mapa"
                                        icon="fa-map"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_route_list"
        model="ir.ui.view">
        <field name="name">route.route.list</field>
        <field name="model">route.route</field>
        <field name="arch"
            type="xml">
            <list string="Rutas de Venta"
                default_order="create_date desc"
                delete="false"
                import="false">
                <field name="create_date"
                    string="Fecha de creación" />
                <field name="name" />
                <field name="description"
                    optional="hide" />
                <field name="salesperson_ids"
                    widget="many2many_tags" />
                <field name="warehouse_id" />
                <field name="state"
                    widget="badge"
                    decoration-warning="state == 'process'"
                    decoration-success="state == 'end'"
                    decoration-bf="state == 'start'" />
            </list>
        </field>
    </record>

    <record id="view_route_route_search"
        model="ir.ui.view">
        <field name="name">route.route.search</field>
        <field name="model">route.route</field>
        <field name="arch"
            type="xml">
            <search string="Buscar Rutas de Venta">
                <field name="name"
                    string="Referencia o Descripción"
                    filter_domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/>
                <field name="salesperson_ids"
                    string="Repartidor"/>
                <field name="warehouse_id"/>
                <field name="product"/>

                <separator/>
                <filter string="En Borrador"
                    name="state_start"
                    domain="[('state', '=', 'start')]"/>
                <filter string="En Proceso"
                    name="state_process"
                    domain="[('state', '=', 'process')]"/>
                <filter string="Finalizadas"
                    name="state_end"
                    domain="[('state', '=', 'end')]"/>

                <separator/>
                <filter string="Mis Rutas"
                    name="my_routes"
                    domain="[('salesperson_ids', 'in', [uid])]"/>

                <group>
                    <filter string="Estado"
                        name="group_by_state"
                        context="{'group_by': 'state'}"/>
                    <filter string="Almacén"
                        name="group_by_warehouse"
                        context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Fecha de Creación"
                        name="group_by_date"
                        context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_route"
        model="ir.actions.act_window">
        <field name="name">Rutas de Venta</field>
        <field name="path">delivery-routes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">route.route</field>
        <field name="view_mode">list,form</field>
        <field name="help"
            type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear Rutas
            </p>
        </field>
    </record>

    <menuitem id="sub_menu_route"
        name="Rutas de Venta"
        parent="delivery_routes.main_menu"
        action="action_route"
        sequence="8" />
</odoo>