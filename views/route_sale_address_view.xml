<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_route_form_sale_address" model="ir.ui.view">
        <field name="name">route.sale.address.form</field>
        <field name="model">route.sale.address</field>
        <field name="arch" type="xml">
            <form string="Ruta de Venta">
                <sheet>
                    <group>
                        <h1>
                            <field name="contact" placeholder="Contacto" colspan="4" readonly="1" />
                        </h1>
                    </group>
                    <group>
                        <group>
                            <field name="address" placeholder="Descripción de la ruta" readonly="1" />
                        </group>
                        <group>
                            <field name="status" />
                        </group>
                    </group>
                    <group>
                        <field name="product_lines">
                            <list editable="bottom">
                                <field name="product_id" />
                                <field name="quantity" sum="Total" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="handle_button_sale"
                        string="Generar cotización"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'visited' or state != 'process'"
                        icon="fa-file-text-o" />
                    <button
                        string="Guardar"
                        type="object"
                        special="save"
                        class="btn-secondary"
                        icon="fa-save"
                        invisible="state != 'process'" />
                    <button name="action_load_route_products"
                        string="Cargar Productos de Ruta"
                        type="object"
                        class="btn-secondary"
                        icon="fa-cubes"
                        invisible="state != 'process'" />
                </footer>
            </form>
        </field>
    </record>
</odoo>