<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_route_form_sale_address"
        model="ir.ui.view">
        <field name="name">route.sale.address.form</field>
        <field name="model">route.sale.address</field>
        <field name="arch"
            type="xml">
            <form string="Ruta de Venta">
                <header>
                    <button name="handle_button_sale"
                        string="Generar Cotización"
                        type="object"
                        class="btn-primary"
                        icon="fa-file-text-o"
                        invisible="status != 'visited' or sale_order_id"/>
                    <button name="handle_button_ticket"
                        string="Re-Imprimir Ticket"
                        type="object"
                        class="btn-secondary"
                        icon="fa-print"
                        invisible="status != 'visited' or not ticket_pdf"/>
                    <button name="action_load_route_products"
                        string="Cargar Productos"
                        type="object"
                        class="btn-secondary"
                        icon="fa-refresh"
                        invisible="state != 'process' or sale_order_id"/>

                    <field name="status"
                        widget="statusbar"
                        readonly="sale_order_id or state != 'process'"
                        options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="contact"
                            string="Contacto"/>
                        <h1>
                            <field name="contact"
                                readonly="1"
                                options="{'no_open': True}"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="address"
                                readonly="1"/>
                            <field name="route_id"
                                readonly="1"/>
                            <field name="is_refund"
                                readonly="is_refunded"/>
                            <field name="is_tasting"
                                readonly="is_tasted"/>
                        </group>
                        <group>
                            <field name="sale_order_id"
                                invisible="not sale_order_id"/>
                            <field name="refund_id"
                                invisible="not refund_id"/>
                            <field name="tasting_id"
                                invisible="not tasting_id"/>
                            <field name="state"
                                invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Productos"
                            name="products">
                            <div class="text-muted mb-2 o_horizontal_separator text-uppercase fw-bolder small">
                            El precio puede cambiar dependiendo de la configuración del cliente.
                            </div>
                            <field name="product_lines"
                                readonly="sale_order_id or state != 'process'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="no_charge"
                                        width="150"
                                        widget="boolean_toggle"/>
                                    <field name="quantity"
                                        sum="Total Cantidad"/>
                                    <field name="price"
                                        width="150"/>
                                </list>
                            </field>
                        </page>
                        <page string="Devoluciones"
                            invisible="not is_refund">
                            <field name="return_lines"
                                readonly="state != 'process' or is_refunded">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_ids"
                                        widget="many2many_tags"
                                        readonly="1"/>
                                    <field name="quantity"
                                        sum="Total Cantidad"
                                        readonly="1"/>

                                    <button name="action_show_details"
                                        type="object"
                                        icon="fa-list"
                                        title="Detalles del lote"
                                        groups="stock.group_production_lot"/>
                                </list>
                            </field>

                            <group>
                                <button name="create_return_picking"
                                    string="Generar devolución"
                                    type="object"
                                    class="btn-secondary"
                                    icon="fa-archive"
                                    invisible="is_refunded"/>
                            </group>
                        </page>
                        <page string="Degustación"
                            invisible="not is_tasting">
                            <field name="tasting_lines"
                                readonly="state != 'process' or is_tasted">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_ids"
                                        widget="many2many_tags"
                                        readonly="1"/>
                                    <field name="quantity"
                                        sum="Total Cantidad"
                                        readonly="1"/>

                                    <button name="action_show_details"
                                        type="object"
                                        icon="fa-list"
                                        title="Detalles del lote"
                                        groups="stock.group_production_lot"/>
                                </list>
                            </field>

                            <group>
                                <button name="create_tasting_picking"
                                    string="Generar degustación"
                                    type="object"
                                    class="btn-secondary"
                                    icon="fa-archive"
                                    invisible="is_tasted"/>
                            </group>
                        </page>
                        <page string="Ticket PDF"
                            name="ticket"
                            invisible="not ticket_pdf">
                            <field name="ticket_pdf"
                                widget="pdf_viewer"
                                nolabel="1"/>
                        </page>
                    </notebook>

                    <div class="text-center text-muted"
                        invisible="ticket_pdf">
                        <p class="o_view_nocontent_smiling_face">
                            El ticket aparecerá una vez generada la cotización.
                        </p>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>