<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_route_form_sale_address"
        model="ir.ui.view">
        <field name="name">route.sale.address.form</field>
        <field name="model">route.sale.address</field>
        <field name="arch"
            type="xml">
            <form string="Ruta de Venta">
                <sheet>
                    <group>
                        <h1>
                            <field name="contact"
                                placeholder="Contacto"
                                colspan="4"
                                readonly="1"
                                class="border-bottom" />
                        </h1>
                    </group>
                    <group>
                        <group>
                            <div class="mb-2 border-bottom">
                                <field name="address"
                                    placeholder="Descripción de la ruta"
                                    readonly="1"
                                    colspan="4" />
                            </div>
                            <field name="status" />
                            <notebook>
                                <page string="Productos">
                                    <field name="product_lines">
                                        <list editable="bottom">
                                            <field name="product_id" />
                                            <field name="quantity"
                                                sum="Total" />
                                        </list>
                                    </field>
                                </page>
                            </notebook>
                        </group>
                        <group invisible="not ticket_pdf">
                            <div class="oe_span6">
                                <field name="ticket_pdf"
                                    widget="pdf_viewer" />
                            </div>
                        </group>
                        <group invisible="ticket_pdf">
                            <div class="oe_span12 text-center items-center">
                                <p class="o_view_nocontent_smiling_face">No hay tickets asignados.</p>
                            </div>
                        </group>
                    </group>
                </sheet>
                <chatter />
                <footer>
                    <button name="handle_button_ticket"
                        string="Imprimir ticket"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'visited' or state != 'process' or sale_order_id == False"
                        icon="fa-print" />
                    <button name="handle_button_sale"
                        string="Generar cotización"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'visited' or state != 'process'"
                        icon="fa-file-text-o" />
                    <button string="Guardar"
                        type="object"
                        special="save"
                        class="btn-secondary"
                        icon="fa-save"
                        invisible="state != 'process'" />
                    <button name="action_load_route_products"
                        string="Cargar Productos de Ruta"
                        type="object"
                        class="btn-secondary"
                        icon="fa-cubes"
                        invisible="state != 'process'" />
                </footer>
            </form>
        </field>
    </record>
</odoo>