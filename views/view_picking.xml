<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_stock"
        model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id"
            ref="stock.view_picking_form"/>
        <field name="arch"
            type="xml">
            <xpath expr="//header/button[@name='do_print_picking']"
                position="before">
                <button name="do_print_ticket"
                    string="Imprimir Ticket"
                    type="object"
                    class="oe_highlight"
                    invisible="state != 'done'"/>
            </xpath>
        </field>
    </record>
</odoo>
