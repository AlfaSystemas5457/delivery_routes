<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="delivery_routes.AddressCard">
        <div class="address-card p-3 cursor-pointer shadow-sm border d-flex justify-content-between align-items-center w-md-50 w-xl-25"
            t-on-click="() => props.onClick(props.address)">

            <div class="w-100 me-3">
                <h3>
                    <strong>
                        <t t-out="props.address.contact[1]"/>
                    </strong>
                </h3>
                <div class="text-muted small">
                    <i class="fa fa-map-marker me-1"/>
                    <t t-out="props.address.address"/>
                </div>

                <span t-att-class="{
                'badge mt-1': true,
                'bg-warning font-color-black': props.address.status === 'pending',
                'bg-success font-color-white': props.address.status === 'visited',
                'bg-danger font-color-white': props.address.status === 'skipped',
            }">
                    <t t-out="statusLabel"/>
                </span>

                <!-- Barra de progreso -->
                <div class="progress mt-2"
                    style="height: 6px;">
                    <div class="progress-bar bg-primary"
                        role="progressbar"
                        t-att-style="`width: ${progressPercent}%`"
                        aria-valuemin="0"
                        aria-valuemax="100"/>
                </div>
                <small class="text-muted">
                    <t t-out="progressPercent"/>
%
                </small>
            </div>

            <button class="btn btn-primary rounded-circle shadow-sm"
                style="width: 40px; height: 40px;">
                <i class="fa fa-chevron-right"/>
            </button>
        </div>

    </t>
</templates>
