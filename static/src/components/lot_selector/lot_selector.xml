<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="delivery_routes.LotSelector"
        owl="1">
        <div class="dropdown w-100"
            t-ref="root">
            <input type="text"
                class="form-control"
                t-att-placeholder="props.placeholder"
                t-att-value="state.searchTerm"
                t-on-input="onInput"
                t-on-focus="() => this.state.showDropdown = true"
                t-att-disabled="props.readonly"
                autocomplete="off"/>

            <ul t-if="state.showDropdown and filteredLots.length > 0"
                class="dropdown-menu show w-100 shadow"
                style="max-height: 200px; overflow-y: auto; display: block; position: absolute; z-index: 1000;">
                <t t-foreach="filteredLots"
                    t-as="lot"
                    t-key="lot.id">
                    <li>
                        <a class="dropdown-item d-flex justify-content-between align-items-center"
                            href="#"
                            t-on-click.prevent="() => this.selectLot(lot)">
                            <span t-esc="lot.name"/>
                            <small class="text-muted"
                                t-esc="lot.product_qty + ' ud.'"/>
                        </a>
                    </li>
                </t>
            </ul>
        </div>
    </t>
</templates>