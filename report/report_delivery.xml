<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_route_ticket_delivery">
        <t t-call="web.basic_layout">
            <t t-call="web.html_container">
                <t t-foreach="docs"
                    t-as="record">
                    <div class="page mt-2">
                        <div class="d-flex flex-column justify-content-center">
                            <h2 class="text-center">Ticket de entrega</h2>
                            <h3 class="w-100 m-0">Datos del cliente</h3>
                            <span t-if="record.partner_id">
                                <strong class="w-100 m-0 p-0">Nombre:</strong>
                                <t t-esc="record.partner_id.name" />
                                <br/>
                            </span>
                            <span t-if="record.partner_id">
                                <strong class="w-100 m-0">Dirección:</strong>
                                <span t-out="', '.join(filter(None, [record.partner_id.street, record.partner_id.street2, record.partner_id.city]))"/>
                                <span t-if="record.partner_id.state_id"
                                    t-out="' %s %s' % (record.partner_id.state_id.name, record.partner_id.country_id.name)"/>
                                <span t-if="record.partner_id.zip"
                                    t-field="record.partner_id.zip"/>
                                <br/>
                            </span>
                            <span t-if="record.sale_id.user_id">
                                <strong class="w-100 m-0">Agente:</strong>
                                <t t-esc="record.sale_id.user_id.name" />
                                <br/>
                            </span>
                            <span t-if="record.date_done">
                                <strong class="w-100 m-0">Fecha de entrega:</strong>
                                <t t-esc="record.date_done" />
                                <br/>
                            </span>
                        </div>

                        <table class="table table-sm table-borderless mt16">
                            <thead class="border-bottom">
                                <tr>
                                    <th>Producto</th>
                                    <th>Demanda</th>
                                </tr>
                            </thead>
                            <tbody class="border-bottom">
                                <t t-foreach="record.move_ids"
                                    t-as="line">
                                    <tr>
                                        <td>
                                            <span t-esc="line.product_id.name" />
                                        </td>
                                        <td>
                                            <span t-esc="line.product_uom_qty" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="w-100 mt16 mb16 d-flex flex-column justify-content-center align-items-center text-muted"
                            t-if="record.customer_signature">
                            <img t-att-src="image_data_uri(record.customer_signature)"
                                class="img img-fluid"
                                style="max-width: 200px;"/>
                            <div class="text-center mt8 border-top w-100">
                                <span>Firma del cliente</span>
                            </div>
                        </div>

                        <br/>
                        <br/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_route_sale_delivery_ticket"
        model="ir.actions.report">
        <field name="name">Ticket entrega</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">delivery_routes.report_route_ticket_delivery</field>
        <field name="report_file">delivery_routes.report_route_ticket_delivery</field>
        <field name="paperformat_id"
            ref="delivery_routes.custom_paperformat_ticket_sale_delivery" />
        <field name="print_report_name">'Ticket de entrega %s' % object.display_name</field>
        <field name="binding_model_id"
            ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>
</odoo>
  