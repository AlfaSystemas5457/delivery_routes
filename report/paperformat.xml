<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="custom_paperformat_ticket_sale_delivery"
        model="report.paperformat">
        <field name="name">Custom Paperformat Ticket Sale Delivery</field>
        <field name="default"
            eval="True" />
        <field name="disable_shrinking"
            eval="True" />
        <field name="dpi">96</field>
        <field name="format">custom</field>
        <field name="page_height">300</field>
        <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
    </record>

    <record id="custom_paperformat_a4_delivery"
        model="report.paperformat">
        <field name="name">Custom Paperformat A4 Delivery</field>
        <field name="default"
            eval="True" />
        <field name="disable_shrinking"
            eval="False" />
        <field name="dpi">90</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="header_spacing">48</field>
        <field name="margin_top">48</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="css_margins"
            eval="True"/>
    </record>
</odoo>