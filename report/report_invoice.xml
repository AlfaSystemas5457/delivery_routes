<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_route_ticket_invoice">
        <t t-call="web.basic_layout">
            <t t-call="web.html_container">
                <t t-foreach="docs"
                    t-as="record">
                    <div class="page mt-2">
                        <div class="d-flex flex-column justify-content-center">
                            <h2 class="text-center">Ticket de factura</h2>
                            <div t-if="record.partner_id">
                                <strong>Contacto:</strong>
                                <t t-esc="record.partner_id.name" />
                            </div>
                            <div t-if="record.partner_id">
                                <strong>Dirección:</strong>
                                <span t-out="', '.join(filter(None, [record.partner_id.street, record.partner_id.street2, record.partner_id.city]))"/>
                                <span t-if="record.partner_id.state_id"
                                    t-out="' %s %s' % (record.partner_id.state_id.name, record.partner_id.country_id.name)"/>
                                <span t-if="record.partner_id.zip"
                                    t-field="record.partner_id.zip"/>
                            </div>
                            <div t-if="record.invoice_user_id">
                                <strong>Agente:</strong>
                                <t t-esc="record.invoice_user_id.name" />
                            </div>
                        </div>

                        <h4>Productos:</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="record.invoice_line_ids"
                                    t-as="line">
                                    <tr>
                                        <td>
                                            <t t-esc="line.product_id.name" />
                                        </td>
                                        <td>
                                            <t t-esc="line.quantity" />
                                        </td>
                                        <td>
                                            <t t-esc="line.price_unit" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h4>Total de facturación:</h4>
                        <div t-if="record.amount_untaxed">
                            <strong>Subtotal:</strong>
                            <t t-esc="record.amount_untaxed" />
                        </div>
                        <div t-if="record.amount_tax">
                            <strong>Impuestos:</strong>
                            <t t-esc="record.amount_tax" />
                        </div>
                        <div t-if="record.amount_total">
                            <strong>Total:</strong>
                            <t t-esc="record.amount_total" />
                        </div>

                        <t t-if="record.status_in_payment == 'paid'">
                            <h5 class="text-muted text-center">Factura pagada</h5>
                        </t>

                        <br/>
                        <br/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_route_sale_invoice_ticket"
        model="ir.actions.report">
        <field name="name">Ticket factura</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">delivery_routes.report_route_ticket_invoice</field>
        <field name="report_file">delivery_routes.report_route_ticket_invoice</field>
        <field name="paperformat_id"
            ref="delivery_routes.custom_paperformat_ticket_sale_delivery" />
        <field name="print_report_name">'Ticket de factura %s' % object.display_name</field>
        <field name="binding_model_id"
            ref="account.model_account_move" />
        <field name="binding_type">report</field>
    </record>
</odoo>
  